# ── Local Docker Compose ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/spanish_app
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
NEXT_PUBLIC_API_URL=http://localhost:3000/api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spanish_

# DeepL translation for the podcast word-tap → vocabulary feature.
# Get a key at https://www.deepl.com/pro-api (free keys end with ":fx").
DEEPL_API_KEY=

# Google Gemini — vocabulary enrichment (chunks/synonyms/gender...) and the
# level-5 sentence grading. https://aistudio.google.com/apikey
GEMINI_KEY=

# Pexels image search for the level-2 picture exercise. https://www.pexels.com/api/
PEXELS_API_KEY=

# ── Production (set these in Railway / Vercel dashboards) ─────────────
# BACKEND_URL=https://your-backend.up.railway.app   (Vercel + auth.ts + dashboard)
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000  (Railway backend)
