# ── Local Docker Compose ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/spanish_app
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
NEXT_PUBLIC_API_URL=http://localhost:3000/api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spanish_app

# Every key below is optional. Features degrade gracefully when one is unset.

# DeepL translation for the podcast word-tap → vocabulary feature.
# Get a key at https://www.deepl.com/pro-api (free keys end with ":fx").
DEEPL_API_KEY=

# Mistral (Mistral Small 4) — vocabulary enrichment (chunks/synonyms/gender...)
# and the level-5 sentence grading. https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Anthropic Claude — fallback for enrichment/grading when Mistral fails or is
# rate-limited. Uses the cheapest model (Haiku). https://console.anthropic.com/
CLAUDE_API_KEY=

# Pexels image search for the level-2 picture exercise. https://www.pexels.com/api/
PEXELS_API_KEY=

# ElevenLabs — Speaking tab voice mode (speech-to-text + text-to-speech) and
# B1 listening stories' TTS. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Second character's voice for long-form (~10min) two-voice B1 stories.
ELEVENLABS_VOICE_ID_SECONDARY=jBlmi27XRORxjPquUeCh

# Podcast pipeline (yt-dlp + faster-whisper). Model size: tiny | base | small | medium.
WHISPER_MODEL=base
# Set to 0 to disable the 30-minute podcast refresh job (required if you run >1 worker).
ENABLE_SCHEDULER=1
