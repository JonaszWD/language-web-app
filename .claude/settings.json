{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 10
          }
        ],
        "description": "Load pending tasks, disk check, stale state cleanup",
        "id": "session:start"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-dangerous.sh\"",
            "timeout": 5
          }
        ],
        "description": "Hard-block catastrophic commands; soft-block risky reversible ones",
        "id": "pre:bash:block-dangerous"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/scan-secrets.sh\"",
            "timeout": 10
          }
        ],
        "description": "Scan written files for accidental secret exposure",
        "id": "post:write:scan-secrets"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/compact-save.sh\"",
            "timeout": 10
          }
        ],
        "description": "Save checkpoint to session-learnings.md before compaction",
        "id": "pre:compact:save"
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/compact-restore.sh\"",
            "timeout": 5
          }
        ],
        "description": "Surface last checkpoint after compaction so agent re-orients",
        "id": "post:compact:restore"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-completion.sh\"",
            "timeout": 10
          }
        ],
        "description": "Warn if tasks are still marked [~] without completion evidence",
        "id": "stop:verify-completion"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/end-of-turn-typecheck.sh\"",
            "timeout": 60
          }
        ],
        "description": "Run mypy/pyright on Python files after each turn",
        "id": "stop:typecheck"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/desktop-notify.sh\"",
            "async": true,
            "timeout": 5
          }
        ],
        "description": "macOS desktop notification when Claude finishes a turn",
        "id": "stop:desktop-notify"
      }
    ]
  }
}
